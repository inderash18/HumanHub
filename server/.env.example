# ==========================================
# HumanHub Server Environment Configuration
# ==========================================

# Server Network & Runtime
PORT=5000
NODE_ENV=production

# Frontend Origin & CORS (Exact URLs, comma-separated if multiple)
# Example: https://humanhub.vercel.app,http://localhost:3000
FRONTEND_URL=https://your-frontend-name.vercel.app
CORS_ORIGIN=https://your-frontend-name.vercel.app

# Cross-Domain Cookie Settings (For Vercel frontend + Render backend)
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# Database: MongoDB Atlas Connection String (M0 Free Tier)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/humanhub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/humanhub?retryWrites=true&w=majority

# [OPTIONAL] Queue Accelerator: Upstash Redis or Local Redis
# If omitted or empty, the backend automatically runs in MongoDB-only mode
# using atomic findOneAndUpdate and lease-based stale job recovery.
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# AI Origin & Image Analysis Microservice
# Example: https://humanhub-ai.onrender.com (or http://localhost:8000 for local)
AI_SERVICE_URL=http://localhost:8000

# Authentication & Encryption Secrets (Minimum 32 characters random string)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_32_plus_char_random_jwt_secret_key_here
JWT_REFRESH_SECRET=your_32_plus_char_random_jwt_refresh_secret_key_here
MFA_ENCRYPTION_KEY=your_32_plus_char_random_mfa_encryption_key_here

# Persistent Cloud Media Storage (Cloudinary Free Tier: 25GB)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional Email / SMTP Delivery (For password reset and email OTP)
# Can use Resend (free 3000 emails/mo) or Gmail App Password or Brevo (free 300 emails/day)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=your_smtp_api_key
SMTP_FROM="HumanHub Security" <no-reply@yourdomain.com>
