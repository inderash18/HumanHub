# Server Network Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database & Cache URIs
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/humanhub?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# Microservices
AI_SERVICE_URL=http://localhost:8000

# Authentication
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# FRONTEND_URL can contain comma-separated exact trusted origins.

# Cloudinary (Optional: for media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# Email delivery is required for registration/reset (no OTP console fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Alternatively configure GMAIL_USER and GMAIL_APP_PASSWORD locally.
