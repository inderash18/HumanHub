# ==========================================
# HumanHub Production & Development Environment Template
# ==========================================

# Deployment & Ports
NODE_ENV=production
PORT=5000
AI_PORT=8000
CLIENT_PORT=3000

# Security & Secrets (Minimum 64 characters / 256-bit entropy)
JWT_SECRET=generate_with_openssl_rand_hex_32_chars_minimum
JWT_REFRESH_SECRET=generate_with_openssl_rand_hex_32_chars_minimum
MFA_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32_chars_minimum

# Password Hashing (Argon2id OWASP Level 2 Parameters)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Origins & Networking
FRONTEND_URL=https://humanhub.example.com
CORS_ORIGIN=https://humanhub.example.com
VITE_API_URL=/api
VITE_SOCKET_URL=/

# Databases & Cache (Use private network in production; no public exposure)
MONGODB_URI=mongodb://mongo:27017/humanhub
REDIS_URL=redis://redis:6379
PG_URI=postgresql://postgres:postgres@postgres:5432/humanhub

# AI Origin & Provenance Analysis
AI_SERVICE_URL=http://ai_services:8000
MODEL_CACHE_DIR=/models
ENABLE_C2PA_VERIFICATION=true

# Email & Recovery Delivery
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_ses_api_key
SMTP_FROM="HumanHub Security" <no-reply@humanhub.example.com>
