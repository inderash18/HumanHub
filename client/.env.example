# ==========================================
# HumanHub Client Environment Variables
# ==========================================

# Production: Set to your deployed Render/custom backend URL
# Example: https://humanhub-backend.onrender.com/api
# Development: http://localhost:5000/api
VITE_API_URL=https://your-backend-name.onrender.com/api

# Production: Set to your deployed Render/custom backend root URL
# Example: https://humanhub-backend.onrender.com
# Development: http://localhost:5000
VITE_SOCKET_URL=https://your-backend-name.onrender.com
